{
  "name": "agents-office",
  "version": "3.2.1",
  "description": "Codspot World v3 \u2014 a 3D isometric office where AI agents do real work on your own Claude login",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node serve.mjs",
    "build": "node build.mjs",
    "check": "node check.mjs",
    "check:live": "CHECK_LIVE=1 node check.mjs",
    "graph": "node graph-build.mjs",
    "docker:up": "docker compose up -d --build",
    "docker:restart": "docker compose restart",
    "docker:logs": "docker compose logs -f --tail 100",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "d3-force": "^3.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "three": "^0.185.1",
    "playwright-core": "^1.62.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.80.0"
  }
}
